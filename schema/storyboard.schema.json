{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heritage-short/storyboard",
  "title": "Heritage short storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "language",
    "tts_model",
    "style_block",
    "wan",
    "characters",
    "music",
    "shots",
    "end_cards"
  ],
  "$defs": {
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "reference_prompt",
        "seed",
        "golden_reference",
        "real_person",
        "consent_ref",
        "voice",
        "voice_style"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "reference_prompt": {
          "$ref": "#/$defs/text"
        },
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "golden_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "real_person": {
          "type": "boolean"
        },
        "consent_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "voice": {
          "type": [
            "string",
            "null"
          ]
        },
        "voice_style": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "real_person": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "consent_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "shot_size",
        "duration_s",
        "characters",
        "image_prompt",
        "image_seed",
        "motion_prompt",
        "motion_seed",
        "animate",
        "ken_burns",
        "lines",
        "music_cue",
        "use_references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s(0[1-9]|1[0-2])$"
        },
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "shot_size": {
          "enum": [
            "extreme_wide",
            "wide",
            "medium",
            "medium_close",
            "close",
            "extreme_close",
            "insert"
          ]
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 10
        },
        "characters": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "image_prompt": {
          "$ref": "#/$defs/text"
        },
        "image_seed": {
          "$ref": "#/$defs/seed"
        },
        "motion_prompt": {
          "type": "string"
        },
        "motion_seed": {
          "$ref": "#/$defs/seed"
        },
        "animate": {
          "enum": [
            "none",
            "9x16",
            "both"
          ]
        },
        "ken_burns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zoom_from",
            "zoom_to",
            "pan"
          ],
          "properties": {
            "zoom_from": {
              "type": "number",
              "minimum": 1.0,
              "maximum": 1.5
            },
            "zoom_to": {
              "type": "number",
              "minimum": 1.0,
              "maximum": 1.5
            },
            "pan": {
              "enum": [
                "none",
                "left",
                "right",
                "up",
                "down"
              ]
            }
          }
        },
        "music_cue": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "use_references": {
          "type": "boolean"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "text",
        "subtitle_en",
        "style",
        "tts_model"
      ],
      "properties": {
        "speaker": {
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "subtitle_en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "style": {
          "type": "string"
        },
        "tts_model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "subtitle_en",
        "duration_s"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "subtitle_en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 8
        }
      }
    }
  },
  "properties": {
    "title": {
      "$ref": "#/$defs/text"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "style_block": {
      "$ref": "#/$defs/text"
    },
    "wan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_9x16",
        "size_16x9",
        "frames"
      ],
      "properties": {
        "size_9x16": {
          "const": "704*1280"
        },
        "size_16x9": {
          "const": "1280*704"
        },
        "frames": {
          "type": "integer",
          "minimum": 17,
          "maximum": 161
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caption",
        "bpm",
        "key",
        "duration_s",
        "seeds",
        "chosen",
        "chosen_reason",
        "use_placeholder"
      ],
      "properties": {
        "caption": {
          "$ref": "#/$defs/text"
        },
        "bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "key": {
          "$ref": "#/$defs/text"
        },
        "duration_s": {
          "type": "number",
          "minimum": 30,
          "maximum": 240
        },
        "seeds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/seed"
          }
        },
        "chosen": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "chosen_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "use_placeholder": {
          "type": "boolean"
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "tts_model": {
      "$ref": "#/$defs/text"
    },
    "end_cards": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/end_card"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "motion": {
      "enum": [
        "ken_burns",
        "parallax"
      ]
    }
  }
}
